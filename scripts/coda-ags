#!/usr/bin/env bash
# Start or talk to the vendored CodaLinux AGS/Astal shell (instance "coda").
# ags/bun stats the process cwd (`stat .`). Never inherit an unreadable
# directory (e.g. root on tty2 with cwd /root).
set -euo pipefail

export GI_TYPELIB_PATH="/usr/local/lib/girepository-1.0${GI_TYPELIB_PATH:+:${GI_TYPELIB_PATH}}"
export LD_LIBRARY_PATH="/usr/local/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export XDG_DATA_DIRS="/usr/local/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

ags="${CODA_AGS_BIN:-/usr/local/bin/ags}"
appdir="${CODA_AGS_APP:-/usr/local/share/codalinux/ags}"
instance="${CODA_AGS_INSTANCE:-coda}"

if [[ -z "${HOME:-}" || ! -d "${HOME}" ]]; then
  HOME="$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f6 || true)"
  HOME="${HOME:-/tmp}"
  export HOME
fi

for dir in "${HOME}" /tmp "${appdir}" /; do
  if [[ -n "${dir}" && -d "${dir}" && -r "${dir}" && -x "${dir}" ]]; then
    cd "${dir}"
    break
  fi
done

if [[ ! -x "${ags}" ]]; then
  echo "coda-ags: vendored AGS binary not found at ${ags}" >&2
  exit 1
fi

cmd="${1:-run}"
if [[ "${cmd}" == run ]]; then
  shift || true
  if [[ -n "${XDG_RUNTIME_DIR:-}" && -n "${WAYLAND_DISPLAY:-}" ]]; then
    if [[ ! -e "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]]; then
      echo "coda-ags: Wayland display ${WAYLAND_DISPLAY} not ready under ${XDG_RUNTIME_DIR} (Hyprland not up, or session env is for the wrong user — tty2 root must not inherit /run/user/0)" >&2
      exit 1
    fi
  fi
  exec "${ags}" run "${appdir}" "$@"
fi

exec "${ags}" "${cmd}" "${@:2}" -i "${instance}"
