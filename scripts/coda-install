#!/usr/bin/env bash
# Live-ISO installer: pick one disk, space-check, auto ESP+A+B+data, offline
# split (core → OS-A, desktop → coda-data). Locale/tz/keymap stay Bozeman.
# Silent: CODA_INSTALL_DISK=/dev/vda|auto  (auto = first lsblk disk).
# Default login is user / 1 (root password 1).
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

coda_install_lib_candidates() {
  local p
  if [[ -n "${CODA_INSTALL_LIB_PATHS:-}" ]]; then
    # shellcheck disable=SC2086
    for p in ${CODA_INSTALL_LIB_PATHS}; do
      printf '%s\n' "${p}"
    done
    return 0
  fi
  [[ -n "${CODA_INSTALL_LIB:-}" ]] && printf '%s\n' "${CODA_INSTALL_LIB}"
  printf '%s\n' \
    /usr/local/lib/codalinux/coda-install-lib.sh \
    /usr/share/codalinux/install/coda-install-lib.sh \
    "${here}/coda-install-lib.sh"
}

coda_install_load_lib() {
  # Name kept for check-wrapper-modes. Real load is the top-level loop.
  true
}

unset CODA_INSTALL_LIB_SOURCED
unset -f coda_need_root 2>/dev/null || true
_coda_install_lib=""
_coda_install_lib_ok=0
while IFS= read -r _coda_install_lib; do
  [[ -n "${_coda_install_lib}" && -f "${_coda_install_lib}" && -s "${_coda_install_lib}" ]] || continue
  grep -q 'coda_need_root()' "${_coda_install_lib}" 2>/dev/null || continue
  unset CODA_INSTALL_LIB_SOURCED
  unset -f coda_need_root 2>/dev/null || true
  # shellcheck source=coda-install-lib.sh
  . "${_coda_install_lib}"
  if declare -F coda_need_root >/dev/null 2>&1; then
    _coda_install_lib_ok=1
    break
  fi
done < <(coda_install_lib_candidates)
if [[ "${_coda_install_lib_ok}" -ne 1 ]]; then
  printf 'coda-install: coda-install-lib.sh did not provide coda_need_root\n' >&2
  exit 1
fi
unset _coda_install_lib _coda_install_lib_ok
CODA_INSTALL_LOG_PREFIX=coda-install

engine=""
layout=""
for engine in \
  /usr/local/lib/codalinux/coda-install-ab.sh \
  /usr/share/codalinux/install/coda-install-ab.sh \
  "${here}/coda-install-ab.sh"
do
  [[ -x "${engine}" ]] && break
done
for layout in \
  /usr/local/lib/codalinux/coda-install-layout.py \
  /usr/share/codalinux/install/coda-install-layout.py \
  "${here}/coda-install-layout.py"
do
  [[ -f "${layout}" ]] && break
done
[[ -x "${engine}" ]] || coda_die "coda-install-ab.sh not found"
[[ -f "${layout}" ]] || coda_die "coda-install-layout.py not found"

usage() {
  cat <<'EOF'
Usage: coda-install [--disk DEV|auto] [--yes]

Install CodaLinux onto one disk (wipes it):
  ESP + OS-A + OS-B + data. Core → OS-A; desktop → coda-data.

  --disk DEV    target disk (or CODA_INSTALL_DISK)
  --disk auto   first lsblk disk (QEMU e2e; no prompt)
  --yes         skip the wipe confirmation (implied when CODA_INSTALL_DISK is set)

Bozeman defaults (not asked): en_US.UTF-8, America/Denver, keymap us.
Login after reboot: user / 1
EOF
}

disk="${CODA_INSTALL_DISK:-}"
force=0
if [[ -n "${disk}" || "${CODA_INSTALL_FORCE:-}" == 1 ]]; then
  force=1
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --disk)
      disk="$2"
      shift 2
      ;;
    --yes|--force)
      force=1
      shift
      ;;
    --first-disk)
      disk=auto
      force=1
      shift
      ;;
    *)
      echo "coda-install: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

echo "CodaLinux install defaults (not asked):"
echo "  timezone  America/Denver   (Bozeman, Montana)"
echo "  locale    en_US.UTF-8"
echo "  keymap    us"
echo "  bootloader systemd-boot    root fs ext4    repos official Arch only"
echo "  layout    ESP + OS-A + OS-B + data (core on slots, desktop on data)"
echo
echo "Login after reboot:"
echo "  user: ${CODA_INSTALL_USER:-user}"
echo "  password: ${CODA_INSTALL_PASSWORD:-1}"
echo

if [[ "${EUID}" -ne 0 ]]; then
  exec sudo -E -- "$0" ${disk:+--disk "${disk}"} ${force:+--yes} "$@"
fi

if [[ -z "${disk}" ]]; then
  echo "Select the install disk (this will be partitioned)."
  mapfile -t rows < <(coda_list_disks)
  if [[ "${#rows[@]}" -eq 0 ]]; then
    echo "No disks found." >&2
    exit 1
  fi
  local_i=1
  for row in "${rows[@]}"; do
    printf '  %d) %s\n' "${local_i}" "${row}"
    local_i=$((local_i + 1))
  done
  read -r -p "Disk number or path: " raw
  raw="${raw// /}"
  if [[ "${raw}" =~ ^[0-9]+$ ]] && [[ "${raw}" -ge 1 && "${raw}" -le "${#rows[@]}" ]]; then
    disk="${rows[$((raw - 1))]%% *}"
  else
    disk="${raw}"
  fi
fi

case "${disk}" in
  auto|first|AUTO|FIRST)
    disk="$(coda_first_disk)" || coda_die "no usable disk found"
    echo "Using first disk: ${disk}"
    force=1
    ;;
esac

[[ -b "${disk}" ]] || coda_die "${disk} is not a block device"
export CODA_INSTALL_DISK="${disk}"

if ! python3 "${layout}" check "${disk}"; then
  exit 1
fi

if [[ "${force}" -ne 1 ]]; then
  echo
  echo "This will ERASE ${disk}."
  read -r -p "Type YES to continue: " ans
  [[ "${ans}" == YES ]] || coda_die "aborted"
fi

exec "${engine}" --disk "${disk}"
