#!/usr/bin/env bash
# Live-ISO installer entry: Bozeman/Montana locale defaults are fixed.
# Disk: CODA_INSTALL_DISK=/dev/vda skips the menu and tries a silent layout.
# Creds (opt-in, never hardcoded): CODA_INSTALL_CREDS=… or
# CODA_INSTALL_USER + CODA_INSTALL_PASSWORD [+ CODA_INSTALL_ROOT_PASSWORD].
# Config JSON is written as the invoking user (XDG_RUNTIME_DIR or /tmp).
# disk_config is generated as root (`sudo -E python3 … --emit-layout`) because
# archinstall disk helpers recurse as user live. Then exec sudo -E archinstall.
set -euo pipefail

config="${CODA_ARCHINSTALL_CONFIG:-/usr/share/codalinux/install/user_configuration.json}"
helper="${CODA_INSTALL_HELPER:-/usr/local/lib/codalinux/coda-install-config.py}"

if ! command -v archinstall >/dev/null 2>&1; then
  echo "archinstall is not installed. On the live ISO it should be." >&2
  exit 1
fi

if [[ ! -f "${config}" ]]; then
  echo "Missing ${config}." >&2
  exit 1
fi

echo "CodaLinux install defaults (not asked):"
echo "  timezone  America/Denver   (Bozeman, Montana)"
echo "  locale    en_US.UTF-8"
echo "  keymap    us"
echo "  bootloader systemd-boot    root fs ext4    repos official Arch only"
echo

if [[ -f "${helper}" ]]; then
  exec python3 "${helper}" "${config}" "$@"
fi

echo "Helper missing; launching archinstall with preseeded config."
# archinstall must run as root (partitions / pacstrap). Config generation
# above is user-writable; this fallback only execs the installer.
if [[ "${EUID}" -eq 0 ]]; then
  exec archinstall --config "${config}" "$@"
fi
exec sudo -E -- archinstall --config "${config}" "$@"
