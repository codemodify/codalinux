#!/usr/bin/env python3
"""Hyprland workspace / stack / task helpers for the CodaLinux AGS shell.

Stacking is floating/overlapping windows (hyprfloat-style float mode), not
Hyprland tabbed window groups. hyprfloat itself is a Lua helper that still
speaks pre-0.55 dispatchers and pulls AUR grim-hyprland for overview; v1
keeps official packages only and implements the same workspace-wide
tile ↔ float toggle with ``hyprctl`` + Lua dispatchers.

Commands:
  add              switch to the next empty workspace (emptyn)
  switch ID        focus an existing workspace
  remove           leave the current workspace when it has no windows
  toggle-stack     tile ↔ floating/overlapping on this workspace
  mode             print ``tile`` or ``stack``
  apply-new        float a newly opened window when the workspace is stacked
  focus ADDRESS    focus a window (restore from special:minimized if needed)
  minimize [ADDR]  hide a window on special:minimized (active if omitted)
  toggle ADDRESS   focus, or minimize when it is already focused
  shade [up|down|toggle] [ADDR]
                   KDE-style roll-up: keep the hyprbars titlebar, hide the rest
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any


MINIMIZED_WS = "special:minimized"
# Match plugin:hyprbars.bar_height in desktop/hypr/hyprland.lua.
SHADE_HEIGHT = 28
HYPRCTL = os.environ.get("CODA_HYPRCTL", "hyprctl")
STATE_PATH = Path(
    os.environ.get(
        "CODA_HYPR_WS_STATE",
        str(Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "coda-hypr-ws.json"),
    )
)


def hypr_json(query: str) -> Any:
    out = subprocess.check_output([HYPRCTL, "-j", query], text=True)
    return json.loads(out)


def hypr_run(args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run([HYPRCTL, *args], text=True, capture_output=True)


def dispatch_ok(result: subprocess.CompletedProcess[str]) -> bool:
    if result.returncode != 0:
        return False
    text = f"{result.stdout} {result.stderr}".lower()
    return (
        "invalid" not in text
        and "error" not in text
        and "unknown dispatcher" not in text
    )


def dispatch(lua_expr: str, legacy: list[str] | None = None) -> None:
    """Send a Lua dispatcher, then fall back to a pre-0.55 keyword if needed."""
    result = hypr_run(["dispatch", lua_expr])
    if dispatch_ok(result):
        return
    if legacy:
        result = hypr_run(["dispatch", *legacy])
        if dispatch_ok(result):
            return
    detail = (result.stderr or result.stdout or "").strip()
    raise RuntimeError(detail or f"hyprctl dispatch failed: {lua_expr}")


def win_sel(address: str) -> str:
    addr = (address or "").strip()
    if addr.startswith("address:"):
        addr = addr[len("address:") :]
    if not addr.startswith("0x"):
        addr = f"0x{addr}"
    return f"address:{addr}"


def norm_addr(address: str) -> str:
    addr = (address or "").strip().lower()
    if addr.startswith("address:"):
        addr = addr[len("address:") :]
    if not addr.startswith("0x"):
        addr = f"0x{addr}"
    return addr


def is_special_ws(ws: dict[str, Any] | None) -> bool:
    if not ws:
        return True
    name = str(ws.get("name") or "")
    try:
        wid = int(ws.get("id") or 0)
    except (TypeError, ValueError):
        wid = 0
    return wid < 0 or name.startswith("special")


def is_floating(client: dict[str, Any]) -> bool:
    return bool(client.get("floating"))


def clients_on_workspace(
    clients: list[dict[str, Any]], workspace_id: int
) -> list[dict[str, Any]]:
    found: list[dict[str, Any]] = []
    for client in clients:
        ws = client.get("workspace") or {}
        try:
            cid = int(ws.get("id") or 0)
        except (TypeError, ValueError):
            continue
        if cid == workspace_id:
            found.append(client)
    return found


def load_state() -> dict[str, Any]:
    try:
        data = json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {"modes": {}, "last_ws": {}, "shade": {}}
    if not isinstance(data, dict):
        return {"modes": {}, "last_ws": {}, "shade": {}}
    modes = data.get("modes")
    if not isinstance(modes, dict):
        data["modes"] = {}
    if not isinstance(data.get("last_ws"), dict):
        data["last_ws"] = {}
    if not isinstance(data.get("shade"), dict):
        data["shade"] = {}
    return data


def save_state(state: dict[str, Any]) -> None:
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps(state), encoding="utf-8")


def save_mode(workspace_id: int, mode: str) -> None:
    state = load_state()
    state.setdefault("modes", {})[str(workspace_id)] = mode
    save_state(state)


def remember_last_ws(address: str, workspace_id: int) -> None:
    if workspace_id <= 0:
        return
    state = load_state()
    state.setdefault("last_ws", {})[norm_addr(address)] = workspace_id
    save_state(state)


def last_regular_ws(address: str) -> int | None:
    raw = load_state().get("last_ws", {}).get(norm_addr(address))
    try:
        wid = int(raw)
    except (TypeError, ValueError):
        return None
    return wid if wid > 0 else None


def persisted_mode(workspace_id: int) -> str | None:
    mode = load_state().get("modes", {}).get(str(workspace_id))
    if mode in {"stack", "tile"}:
        return mode
    return None


def workspace_mode(
    clients: list[dict[str, Any]],
    workspace_id: int,
    persisted: str | None = None,
) -> str:
    if persisted in {"stack", "tile"}:
        return persisted
    on_ws = clients_on_workspace(clients, workspace_id)
    if not on_ws:
        return "tile"
    floating = sum(1 for client in on_ws if is_floating(client))
    return "stack" if floating * 2 > len(on_ws) else "tile"


def pick_remove_workspace(
    active_id: int, workspaces: list[dict[str, Any]], client_count: int
) -> int | None:
    """Choose a regular workspace to land on after dropping an empty one."""
    if client_count > 0:
        return None
    others: list[int] = []
    for ws in workspaces:
        if is_special_ws(ws):
            continue
        try:
            wid = int(ws.get("id") or 0)
        except (TypeError, ValueError):
            continue
        if wid > 0 and wid != active_id:
            others.append(wid)
    if not others:
        return None
    lower = [wid for wid in others if wid < active_id]
    if lower:
        return max(lower)
    return min(others)


def client_xywh(client: dict[str, Any]) -> tuple[int, int, int, int]:
    at = client.get("at") or [0, 0]
    size = client.get("size") or [0, 0]
    try:
        x = int(at[0] if isinstance(at, list) else 0)
        y = int(at[1] if isinstance(at, list) else 0)
        width = int(size[0] if isinstance(size, list) else 0)
        height = int(size[1] if isinstance(size, list) else 0)
    except (TypeError, ValueError, IndexError):
        return 0, 0, 0, 0
    return x, y, width, height


def cursor_pos() -> tuple[int, int] | None:
    try:
        data = hypr_json("cursorpos")
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        data = None
    if isinstance(data, dict):
        try:
            return int(data.get("x") or 0), int(data.get("y") or 0)
        except (TypeError, ValueError):
            return None
    result = hypr_run(["cursorpos"])
    text = (result.stdout or "").strip().replace(" ", "")
    if "," not in text:
        return None
    left, right = text.split(",", 1)
    try:
        return int(left), int(right)
    except ValueError:
        return None


def titlebar_hit(client: dict[str, Any], cx: int, cy: int) -> bool:
    """True if the pointer is on this float's hyprbars strip (bar_part_of_window)."""
    if not is_floating(client):
        return False
    x, y, width, height = client_xywh(client)
    if width <= 0 or height <= 0:
        return False
    band = max(SHADE_HEIGHT, min(height, SHADE_HEIGHT + 8))
    return x <= cx <= x + width and y <= cy <= y + band


def window_under_titlebar() -> dict[str, Any] | None:
    pos = cursor_pos()
    if pos is None:
        return None
    cx, cy = pos
    try:
        clients = hypr_json("clients")
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        return None
    hits: list[dict[str, Any]] = []
    for client in clients:
        if titlebar_hit(client, cx, cy):
            hits.append(client)
    if not hits:
        return None
    hits.sort(key=lambda item: int(item.get("focusHistoryID") or 9999))
    return hits[0]


def resolve_client(address: str | None) -> dict[str, Any] | None:
    clients = hypr_json("clients")
    if address:
        found = find_client(clients, address)
        if found:
            return found
    try:
        focused = hypr_json("activewindow")
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        focused = None
    if isinstance(focused, dict) and focused.get("address"):
        return focused
    ranked = sorted(
        clients,
        key=lambda item: int(item.get("focusHistoryID") or 9999),
    )
    for client in ranked:
        if not is_special_ws(client.get("workspace")):
            return client
    return ranked[0] if ranked else None


def client_minimized(address: str) -> bool:
    found = find_client(hypr_json("clients"), address)
    return bool(found and is_special_ws(found.get("workspace")))


def find_client(clients: list[dict[str, Any]], address: str) -> dict[str, Any] | None:
    want = norm_addr(address)
    for client in clients:
        if norm_addr(str(client.get("address") or "")) == want:
            return client
    return None


def regular_workspace_id(active: dict[str, Any], workspaces: list[dict[str, Any]]) -> int:
    if not is_special_ws(active):
        try:
            return int(active.get("id") or 1)
        except (TypeError, ValueError):
            return 1
    for ws in sorted(workspaces, key=lambda item: int(item.get("id") or 0)):
        if not is_special_ws(ws):
            try:
                return int(ws.get("id") or 1)
            except (TypeError, ValueError):
                continue
    return 1


def work_area(monitor: dict[str, Any]) -> tuple[int, int, int, int]:
    x = int(monitor.get("x") or 0)
    y = int(monitor.get("y") or 0)
    width = int(monitor.get("width") or 1920)
    height = int(monitor.get("height") or 1080)
    reserved = monitor.get("reserved") or [0, 0, 0, 0]
    if isinstance(reserved, list) and len(reserved) >= 4:
        left, top, right, bottom = (int(reserved[i] or 0) for i in range(4))
        x += left
        y += top
        width -= left + right
        height -= top + bottom
    y += 10
    height -= 20
    return x, y, max(width, 320), max(height, 240)


def cascade_rects(
    count: int, x: int, y: int, width: int, height: int
) -> list[tuple[int, int, int, int]]:
    if count <= 0:
        return []
    win_w = max(int(width * 0.72), 320)
    win_h = max(int(height * 0.72), 240)
    win_w = min(win_w, width)
    win_h = min(win_h, height)
    step = 36
    max_dx = max(0, width - win_w)
    max_dy = max(0, height - win_h)
    rects: list[tuple[int, int, int, int]] = []
    for i in range(count):
        rects.append((x + min(i * step, max_dx), y + min(i * step, max_dy), win_w, win_h))
    return rects


def monitor_for_workspace(active: dict[str, Any]) -> dict[str, Any]:
    mon_id = active.get("monitorID", active.get("monitor"))
    try:
        monitors = hypr_json("monitors")
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        return {}
    if isinstance(mon_id, str):
        for mon in monitors:
            if mon.get("name") == mon_id:
                return mon
    try:
        mid = int(mon_id)
    except (TypeError, ValueError):
        mid = None
    if mid is not None:
        for mon in monitors:
            if int(mon.get("id") or -1) == mid:
                return mon
    focused = next((mon for mon in monitors if mon.get("focused")), None)
    return focused or (monitors[0] if monitors else {})


def set_window_float(address: str, floating: bool) -> None:
    sel = win_sel(address)
    action = "set" if floating else "unset"
    dispatch(
        f'hl.dsp.focus({{ window = "{sel}" }})',
        legacy=["focuswindow", sel],
    )
    dispatch(
        f'hl.dsp.window.float({{ action = "{action}", window = "{sel}" }})',
        legacy=["setfloating" if floating else "settiled", sel],
    )


def place_window(address: str, x: int, y: int, width: int, height: int) -> None:
    sel = win_sel(address)
    dispatch(
        f'hl.dsp.focus({{ window = "{sel}" }})',
        legacy=["focuswindow", sel],
    )
    try:
        dispatch(
            f"hl.dsp.window.resize({{ x = {width}, y = {height}, relative = false }})",
            legacy=["resizeactive", "exact", str(width), str(height)],
        )
    except RuntimeError:
        pass
    try:
        dispatch(
            f"hl.dsp.window.move({{ x = {x}, y = {y}, relative = false }})",
            legacy=["moveactive", "exact", str(x), str(y)],
        )
    except RuntimeError:
        pass


def apply_workspace_float_rule(workspace_id: int, enable: bool) -> None:
    """Best-effort hyprlang keyword; 0.55 Lua sessions may ignore it."""
    if enable:
        hypr_run(["keyword", "windowrule", f"float, workspace:{workspace_id}"])
    else:
        hypr_run(["keyword", "windowrule", f"unset, workspace:{workspace_id}"])


def cmd_add() -> None:
    dispatch(
        'hl.dsp.focus({ workspace = "emptyn" })',
        legacy=["workspace", "emptyn"],
    )


def cmd_switch(ident: str) -> None:
    target = (ident or "").strip()
    if not target:
        raise SystemExit(2)
    if target.isdigit():
        dispatch(
            f"hl.dsp.focus({{ workspace = {target} }})",
            legacy=["workspace", target],
        )
        return
    dispatch(
        f'hl.dsp.focus({{ workspace = "{target}" }})',
        legacy=["workspace", target],
    )


def cmd_remove() -> None:
    active = hypr_json("activeworkspace")
    clients = hypr_json("clients")
    workspaces = hypr_json("workspaces")
    active_id = int(active.get("id") or 0)
    count = len(clients_on_workspace(clients, active_id))
    dest = pick_remove_workspace(active_id, workspaces, count)
    if dest is None:
        if count > 0:
            print("coda-hypr-ws: current workspace is not empty", file=sys.stderr)
        else:
            print("coda-hypr-ws: no other workspace to switch to", file=sys.stderr)
        raise SystemExit(1)
    dispatch(
        f"hl.dsp.focus({{ workspace = {dest} }})",
        legacy=["workspace", str(dest)],
    )


def cmd_mode() -> None:
    active = hypr_json("activeworkspace")
    wid = int(active.get("id") or 0)
    print(workspace_mode(hypr_json("clients"), wid, persisted_mode(wid)))


def _stack_workspace(clients: list[dict[str, Any]], active: dict[str, Any]) -> None:
    area = work_area(monitor_for_workspace(active))
    rects = cascade_rects(len(clients), *area)
    for client, rect in zip(clients, rects):
        addr = str(client.get("address") or "")
        if not addr:
            continue
        if not is_floating(client):
            set_window_float(addr, True)
        place_window(addr, *rect)


def _tile_workspace(clients: list[dict[str, Any]]) -> None:
    for client in clients:
        if not is_floating(client):
            continue
        addr = str(client.get("address") or "")
        if addr:
            set_window_float(addr, False)


def cmd_toggle_stack(force: str | None = None) -> None:
    active = hypr_json("activeworkspace")
    if is_special_ws(active):
        print("coda-hypr-ws: not on a regular workspace", file=sys.stderr)
        raise SystemExit(1)
    active_id = int(active.get("id") or 0)
    clients = clients_on_workspace(hypr_json("clients"), active_id)
    current = workspace_mode(clients, active_id, persisted_mode(active_id))
    if force in {"stack", "on"}:
        want = "stack"
    elif force in {"tile", "off"}:
        want = "tile"
    else:
        want = "tile" if current == "stack" else "stack"
    if want == "stack":
        _stack_workspace(clients, active)
        apply_workspace_float_rule(active_id, True)
    else:
        _tile_workspace(clients)
        apply_workspace_float_rule(active_id, False)
    save_mode(active_id, want)


def cmd_apply_new() -> None:
    active = hypr_json("activeworkspace")
    if is_special_ws(active):
        return
    active_id = int(active.get("id") or 0)
    if workspace_mode(hypr_json("clients"), active_id, persisted_mode(active_id)) != "stack":
        return
    clients = clients_on_workspace(hypr_json("clients"), active_id)
    area = work_area(monitor_for_workspace(active))
    rects = cascade_rects(len(clients), *area)
    for client, rect in zip(clients, rects):
        addr = str(client.get("address") or "")
        if not addr:
            continue
        if not is_floating(client):
            set_window_float(addr, True)
        place_window(addr, *rect)


def cmd_focus(address: str) -> None:
    clients = hypr_json("clients")
    client = find_client(clients, address)
    if client is None:
        print(f"coda-hypr-ws: no window {address}", file=sys.stderr)
        raise SystemExit(1)
    sel = win_sel(address)
    if is_special_ws(client.get("workspace")):
        dest = last_regular_ws(address) or regular_workspace_id(
            hypr_json("activeworkspace"), hypr_json("workspaces")
        )
        move_window_workspace(sel, str(dest), follow=True)
        return
    dispatch(
        f'hl.dsp.focus({{ window = "{sel}" }})',
        legacy=["focuswindow", sel],
    )


def move_window_workspace(sel: str, dest: str, *, follow: bool) -> None:
    """Move a window; verify it left, because Lua move can no-op with exit 0."""
    follow_lua = "true" if follow else "false"
    dest_num = dest.isdigit()
    lua = (
        f'hl.dsp.window.move({{ workspace = {dest}, follow = {follow_lua}, window = "{sel}" }})'
        if dest_num
        else f'hl.dsp.window.move({{ workspace = "{dest}", follow = {follow_lua}, window = "{sel}" }})'
    )
    attempts: list[tuple[str | None, list[str] | None]] = [
        (lua, ["movetoworkspacesilent" if not follow else "movetoworkspace", f"{dest},{sel}"]),
        (None, ["movetoworkspace", f"{dest},{sel}"]),
        (None, ["movetoworkspacesilent", f"{dest},{sel}"]),
    ]
    addr = sel
    for lua_expr, legacy in attempts:
        if lua_expr:
            try:
                dispatch(lua_expr, legacy=legacy)
            except RuntimeError:
                if legacy:
                    hypr_run(["dispatch", *legacy])
        elif legacy:
            hypr_run(["dispatch", *legacy])
        if dest.startswith("special"):
            if client_minimized(addr):
                return
        else:
            found = find_client(hypr_json("clients"), addr)
            ws = (found or {}).get("workspace") or {}
            try:
                if int(ws.get("id") or 0) == int(dest):
                    return
            except (TypeError, ValueError):
                if found and not is_special_ws(ws):
                    return
    if dest.startswith("special") and not client_minimized(addr):
        raise RuntimeError(f"could not move {sel} to {dest}")


def cmd_minimize(address: str | None = None) -> None:
    client = resolve_client(address)
    if client is None:
        print("coda-hypr-ws: no window to minimize", file=sys.stderr)
        raise SystemExit(1)
    addr = str(client.get("address") or "")
    if not addr:
        print("coda-hypr-ws: no window to minimize", file=sys.stderr)
        raise SystemExit(1)
    if is_special_ws(client.get("workspace")):
        return
    ws = client.get("workspace") or {}
    try:
        remember_last_ws(addr, int(ws.get("id") or 0))
    except (TypeError, ValueError):
        pass
    move_window_workspace(win_sel(addr), MINIMIZED_WS, follow=False)


def shade_geom(address: str) -> dict[str, Any] | None:
    raw = load_state().get("shade", {}).get(norm_addr(address))
    return raw if isinstance(raw, dict) else None


def save_shade_geom(address: str, x: int, y: int, width: int, height: int) -> None:
    state = load_state()
    state.setdefault("shade", {})[norm_addr(address)] = {
        "x": x,
        "y": y,
        "w": width,
        "h": height,
    }
    save_state(state)


def clear_shade_geom(address: str) -> None:
    state = load_state()
    state.setdefault("shade", {}).pop(norm_addr(address), None)
    save_state(state)


def is_shaded(client: dict[str, Any]) -> bool:
    addr = str(client.get("address") or "")
    if shade_geom(addr):
        _x, _y, _w, height = client_xywh(client)
        return height <= SHADE_HEIGHT + 12
    _x, _y, _w, height = client_xywh(client)
    return 0 < height <= SHADE_HEIGHT + 4


def apply_shade(client: dict[str, Any], want: str) -> None:
    """want is 'up' (shade), 'down' (unshade), or 'toggle'."""
    addr = str(client.get("address") or "")
    if not addr:
        return
    if not is_floating(client):
        return
    x, y, width, height = client_xywh(client)
    shaded = is_shaded(client)
    if want == "up" and shaded:
        return
    if want == "down" and not shaded:
        return
    if want == "toggle":
        want = "down" if shaded else "up"
    if want == "up":
        if height > SHADE_HEIGHT + 4:
            save_shade_geom(addr, x, y, width, height)
        place_window(addr, x, y, max(width, 120), SHADE_HEIGHT)
        return
    saved = shade_geom(addr)
    if saved:
        place_window(
            addr,
            int(saved.get("x") or x),
            int(saved.get("y") or y),
            max(int(saved.get("w") or width), 120),
            max(int(saved.get("h") or 240), SHADE_HEIGHT + 40),
        )
        clear_shade_geom(addr)
        return
    place_window(addr, x, y, max(width, 320), max(int(height * 8), 240))


def cmd_shade(direction: str | None = None, address: str | None = None) -> None:
    want = (direction or "toggle").lower()
    if want in {"shade", "roll", "rollup"}:
        want = "up"
    if want in {"unshade", "restore", "rolldown"}:
        want = "down"
    if want not in {"up", "down", "toggle"}:
        print(f"coda-hypr-ws: unknown shade direction {direction}", file=sys.stderr)
        raise SystemExit(2)
    client = None
    if address:
        client = find_client(hypr_json("clients"), address)
    elif want in {"up", "down"}:
        # Pointer binds: only act when the cursor is on a float titlebar.
        client = window_under_titlebar()
        if client is None:
            return
    else:
        client = resolve_client(None)
    if client is None:
        if address:
            print(f"coda-hypr-ws: no window {address}", file=sys.stderr)
            raise SystemExit(1)
        return
    apply_shade(client, want)


def cmd_toggle(address: str) -> None:
    focused = hypr_json("activewindow")
    if focused and norm_addr(str(focused.get("address") or "")) == norm_addr(address):
        cmd_minimize(address)
        return
    cmd_focus(address)


def self_test() -> None:
    assert win_sel("0xabc") == "address:0xabc"
    assert win_sel("abc") == "address:0xabc"
    assert win_sel("address:0xABC") == "address:0xABC"
    assert norm_addr("ADDRESS:ABC") == "0xabc"
    assert is_special_ws({"id": -98, "name": "special:minimized"})
    assert is_special_ws({"id": 1, "name": "special:scratch"})
    assert not is_special_ws({"id": 2, "name": "2"})
    assert is_floating({"floating": True})
    assert not is_floating({"floating": False})
    clients = [
        {"workspace": {"id": 2}, "floating": False},
        {"workspace": {"id": 2}, "floating": True},
        {"workspace": {"id": 2}, "floating": True},
    ]
    assert workspace_mode(clients, 2) == "stack"
    assert workspace_mode(clients, 2, "tile") == "tile"
    assert workspace_mode([{"workspace": {"id": 2}, "floating": False}], 2) == "tile"
    workspaces = [
        {"id": 1, "name": "1"},
        {"id": 3, "name": "3"},
        {"id": -98, "name": "special:minimized"},
    ]
    assert pick_remove_workspace(3, workspaces, 1) is None
    assert pick_remove_workspace(3, workspaces, 0) == 1
    assert pick_remove_workspace(1, workspaces, 0) == 3
    assert pick_remove_workspace(1, [{"id": 1, "name": "1"}], 0) is None
    rects = cascade_rects(3, 0, 0, 1000, 800)
    assert len(rects) == 3
    assert rects[0][0] == 0 and rects[1][0] == 36
    assert rects[0][2] < 1000
    floating = {
        "floating": True,
        "at": [100, 200],
        "size": [400, 300],
    }
    assert titlebar_hit(floating, 120, 210)
    assert not titlebar_hit(floating, 120, 280)
    assert not titlebar_hit({"floating": False, "at": [100, 200], "size": [400, 300]}, 120, 210)
    print("ok")


def usage() -> None:
    print(
        "usage: coda-hypr-ws "
        "[add|switch ID|remove|toggle-stack [on|off]|mode|apply-new|"
        "focus ADDR|minimize [ADDR]|toggle ADDR|shade [up|down|toggle] [ADDR]]",
        file=sys.stderr,
    )


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help"}:
        usage()
        return 2
    cmd = argv[0]
    try:
        if cmd == "--self-test":
            self_test()
            return 0
        if cmd == "add":
            cmd_add()
        elif cmd in {"switch", "workspace"}:
            if len(argv) < 2:
                usage()
                return 2
            cmd_switch(argv[1])
        elif cmd == "remove":
            cmd_remove()
        elif cmd in {"toggle-stack", "stack", "toggle_stack", "togglefloat"}:
            force = argv[1] if len(argv) > 1 else None
            cmd_toggle_stack(force)
        elif cmd == "mode":
            cmd_mode()
        elif cmd == "apply-new":
            cmd_apply_new()
        elif cmd == "focus":
            if len(argv) < 2:
                usage()
                return 2
            cmd_focus(argv[1])
        elif cmd == "minimize":
            cmd_minimize(argv[1] if len(argv) > 1 else None)
        elif cmd == "toggle":
            if len(argv) < 2:
                usage()
                return 2
            cmd_toggle(argv[1])
        elif cmd == "shade":
            rest = argv[1:]
            direction = "toggle"
            address = None
            if rest and rest[0] in {
                "up",
                "down",
                "toggle",
                "shade",
                "unshade",
                "roll",
                "rollup",
                "restore",
                "rolldown",
            }:
                direction = rest[0]
                rest = rest[1:]
            if rest:
                address = rest[0]
            cmd_shade(direction, address)
        else:
            usage()
            return 2
    except (OSError, subprocess.CalledProcessError, RuntimeError, json.JSONDecodeError) as exc:
        print(f"coda-hypr-ws: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
