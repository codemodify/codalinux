[Unit]
Description=Coda system-configd (control plane)
Documentation=file:///usr/local/share/codalinux/system-config/README.md
After=graphical-session-pre.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/local/bin/system-configd
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
WantedBy=default.target
