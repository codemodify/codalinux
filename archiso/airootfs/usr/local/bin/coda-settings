#!/usr/bin/env bash
# Coda Settings — official-repo tools opened from the AGS control center.
# Network stays systemd-networkd + iwd (impala). No NetworkManager.
set -euo pipefail

term() {
  if command -v foot >/dev/null 2>&1; then
    exec foot --title="Coda Settings" "$@"
  fi
  exec "$@"
}

open_wifi() {
  if command -v impala >/dev/null 2>&1; then
    term impala
  fi
  if command -v iwctl >/dev/null 2>&1; then
    term iwctl
  fi
  echo "coda-settings: install impala or iwctl for Wi-Fi (iwd)." >&2
  exit 1
}

open_netstatus() {
  term bash -lc '
    echo "CodaLinux network (systemd-networkd + iwd — not NetworkManager)"
    echo
    echo "=== networkctl ==="
    networkctl status || true
    echo
    echo "=== iwctl devices ==="
    iwctl device list 2>/dev/null || true
    echo
    echo "Wi-Fi UI: coda-settings wifi  (impala)"
    echo
    read -r -p "Enter to close "
  '
}

open_bluetooth() {
  if command -v blueman-manager >/dev/null 2>&1; then
    exec blueman-manager
  fi
  if command -v bluetui >/dev/null 2>&1; then
    term bluetui
  fi
  term bluetoothctl
}

open_audio() {
  if command -v pavucontrol >/dev/null 2>&1; then
    exec pavucontrol
  fi
  echo "coda-settings: pavucontrol is not installed." >&2
  exit 1
}

open_webcam() {
  if command -v snapshot >/dev/null 2>&1; then
    exec snapshot
  fi
  echo "coda-settings: snapshot is not installed." >&2
  exit 1
}

open_appearance() {
  if command -v nwg-look >/dev/null 2>&1; then
    exec nwg-look
  fi
  echo "coda-settings: nwg-look is not installed." >&2
  exit 1
}

open_input() {
  term bash -lc 'cat /usr/local/share/codalinux/input-help.txt; echo; read -r -p "Enter to close. Appearance/cursors: nwg-look. "'
}

pick() {
  if command -v coda-ags >/dev/null 2>&1; then
    if coda-ags toggle control-center >/dev/null 2>&1; then
      exit 0
    fi
  fi
  term bash -lc '
    printf "%s\n" \
      "Coda Settings" \
      "1) Network / Wi-Fi" \
      "2) Network status" \
      "3) Bluetooth" \
      "4) Audio" \
      "5) Webcam" \
      "6) Appearance" \
      "7) Mouse & keyboard"
    read -r -p "Choice [1-7]: " n
    case "${n}" in
      1) exec coda-settings wifi ;;
      2) exec coda-settings netstatus ;;
      3) exec coda-settings bluetooth ;;
      4) exec coda-settings audio ;;
      5) exec coda-settings webcam ;;
      6) exec coda-settings appearance ;;
      7) exec coda-settings input ;;
    esac
  '
}

cmd="${1:-menu}"
case "${cmd}" in
  menu|"") pick ;;
  wifi|network) open_wifi ;;
  netstatus|status) open_netstatus ;;
  bluetooth|bt) open_bluetooth ;;
  audio|sound) open_audio ;;
  webcam|camera) open_webcam ;;
  appearance|look) open_appearance ;;
  input|keyboard|mouse) open_input ;;
  *)
    echo "usage: coda-settings [menu|wifi|netstatus|bluetooth|audio|webcam|appearance|input]" >&2
    exit 2
    ;;
esac
