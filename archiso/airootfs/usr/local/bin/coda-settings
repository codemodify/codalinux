#!/usr/bin/env bash
# Coda Settings — System Settings hub helpers for the AGS control center.
# Official-repo tools only. Network stays systemd-networkd + iwd (impala).
# Display uses hyprctl; wlr-randr if present. No NetworkManager / Plasma.
set -euo pipefail

term() {
  if command -v foot >/dev/null 2>&1; then
    exec foot --title="Coda Settings" "$@"
  fi
  exec "$@"
}

open_wifi() {
  if command -v impala >/dev/null 2>&1; then
    term impala
  fi
  if command -v iwctl >/dev/null 2>&1; then
    term iwctl
  fi
  echo "coda-settings: install impala or iwctl for Wi-Fi (iwd)." >&2
  exit 1
}

open_netstatus() {
  term bash -lc '
    echo "CodaLinux network (systemd-networkd + iwd — not NetworkManager)"
    echo
    echo "=== networkctl ==="
    networkctl status || true
    echo
    echo "=== iwctl devices ==="
    iwctl device list 2>/dev/null || true
    echo
    echo "Wi-Fi UI: coda-settings wifi  (impala)"
    echo
    read -r -p "Enter to close "
  '
}

open_bluetooth() {
  if command -v blueman-manager >/dev/null 2>&1; then
    exec blueman-manager
  fi
  if command -v bluetui >/dev/null 2>&1; then
    term bluetui
  fi
  term bluetoothctl
}

open_audio() {
  if command -v pavucontrol >/dev/null 2>&1; then
    exec pavucontrol
  fi
  echo "coda-settings: pavucontrol is not installed." >&2
  exit 1
}

open_webcam() {
  if command -v snapshot >/dev/null 2>&1; then
    exec snapshot
  fi
  echo "coda-settings: snapshot is not installed." >&2
  exit 1
}

open_appearance() {
  if command -v nwg-look >/dev/null 2>&1; then
    exec nwg-look
  fi
  echo "coda-settings: nwg-look is not installed." >&2
  exit 1
}

open_input() {
  term bash -lc 'cat /usr/local/share/codalinux/input-help.txt; echo; read -r -p "Enter to close. Appearance/cursors: nwg-look. "'
}

focused_monitor() {
  hyprctl monitors 2>/dev/null | awk '
    /^Monitor / { name=$2 }
    /focused: yes/ { print name; exit }
  '
}

show_display() {
  echo "CodaLinux display (Hyprland — hyprctl; optional wlr-randr)"
  echo "Session default is 1920x1080@60. Do not use preferred on QEMU virtio:"
  echo "EDID lists 640x480@119.99 first even when 1920x1080 is available."
  echo
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl monitors || true
  else
    echo "hyprctl is not available."
  fi
  echo
  if command -v wlr-randr >/dev/null 2>&1; then
    echo "=== wlr-randr ==="
    wlr-randr || true
    echo
  fi
  echo "Apply: coda-settings display apply 1920x1080@60"
  echo "       coda-settings display apply 1280x720@60"
  echo "       coda-settings display apply preferred [OUTPUT]  (avoid on QEMU)"
}

# Accept 1920x1080, 1920x1080@60, or 1920x1080@60.00Hz.
normalize_mode() {
  local mode="${1:-}"
  if [[ "${mode}" == preferred ]]; then
    printf '%s' preferred
    return
  fi
  mode="${mode%Hz}"
  mode="${mode%.00}"
  if [[ "${mode}" == *@* ]]; then
    printf '%s' "${mode}"
    return
  fi
  if [[ "${mode}" == *[0-9]x[0-9]* ]]; then
    printf '%s@60' "${mode}"
    return
  fi
  printf '%s' "${mode}"
}

apply_display() {
  local mode="${1:-}"
  local output="${2:-}"
  if [[ -z "${mode}" ]]; then
    echo "coda-settings: display apply needs a mode (1920x1080@60, 1280x720@60, preferred)" >&2
    exit 2
  fi
  if [[ -z "${output}" ]]; then
    output="$(focused_monitor || true)"
  fi
  if [[ -z "${output}" ]]; then
    echo "coda-settings: no focused monitor (is Hyprland running?)" >&2
    exit 1
  fi

  mode="$(normalize_mode "${mode}")"

  if [[ "${mode}" != preferred ]] && command -v wlr-randr >/dev/null 2>&1; then
    local wr_mode="${mode%@*}"
    if wlr-randr --output "${output}" --mode "${wr_mode}"; then
      return 0
    fi
  fi

  local spec
  case "${mode}" in
    preferred)
      spec="${output},preferred,auto,1"
      ;;
    *[0-9]x[0-9]*)
      spec="${output},${mode},auto,1"
      ;;
    *)
      echo "coda-settings: unknown mode ${mode}" >&2
      exit 2
      ;;
  esac
  hyprctl keyword monitor "${spec}"
}

open_display() {
  local sub="${1:-status}"
  case "${sub}" in
    status|"")
      term bash -lc 'coda-settings display print; echo; read -r -p "Enter to close "'
      ;;
    print)
      show_display
      ;;
    apply)
      apply_display "${2:-}" "${3:-}"
      ;;
    1920x1080|1920x1080@60|1280x720|1280x720@60|preferred)
      apply_display "${sub}" "${2:-}"
      ;;
    *)
      echo "usage: coda-settings display [status|print|apply MODE [OUTPUT]]" >&2
      exit 2
      ;;
  esac
}

show_about() {
  echo "CodaLinux"
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    echo "${PRETTY_NAME:-CodaLinux}"
  fi
  echo
  uname -srm
  if command -v hostnamectl >/dev/null 2>&1; then
    hostnamectl 2>/dev/null || true
  fi
  echo
  echo "Network: systemd-networkd + iwd (impala). No NetworkManager."
  echo "Shell: Hyprland + AGS. Settings: Super+, or coda-settings"
}

open_about() {
  local sub="${1:-}"
  if [[ "${sub}" == print ]]; then
    show_about
    return
  fi
  term bash -lc 'coda-settings about print; echo; read -r -p "Enter to close "'
}

pick() {
  if command -v coda-ags >/dev/null 2>&1; then
    if coda-ags toggle control-center >/dev/null 2>&1; then
      exit 0
    fi
  fi
  term bash -lc '
    printf "%s\n" \
      "Coda Settings" \
      "1) Display" \
      "2) Network / Wi-Fi" \
      "3) Network status" \
      "4) Bluetooth" \
      "5) Audio" \
      "6) Webcam" \
      "7) Appearance" \
      "8) Mouse & keyboard" \
      "9) About"
    read -r -p "Choice [1-9]: " n
    case "${n}" in
      1) exec coda-settings display ;;
      2) exec coda-settings wifi ;;
      3) exec coda-settings netstatus ;;
      4) exec coda-settings bluetooth ;;
      5) exec coda-settings audio ;;
      6) exec coda-settings webcam ;;
      7) exec coda-settings appearance ;;
      8) exec coda-settings input ;;
      9) exec coda-settings about ;;
    esac
  '
}

cmd="${1:-menu}"
case "${cmd}" in
  menu|"") pick ;;
  wifi|network) open_wifi ;;
  netstatus|status) open_netstatus ;;
  bluetooth|bt) open_bluetooth ;;
  audio|sound) open_audio ;;
  webcam|camera) open_webcam ;;
  appearance|look) open_appearance ;;
  input|keyboard|mouse) open_input ;;
  display|monitors|resolution) open_display "${2:-status}" "${3:-}" "${4:-}" ;;
  about|system) open_about "${2:-}" ;;
  *)
    echo "usage: coda-settings [menu|display|wifi|netstatus|bluetooth|audio|webcam|appearance|input|about]" >&2
    exit 2
    ;;
esac
