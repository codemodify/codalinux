# archiso build trees
/work/
/work-rebuild/
/out/
/out-rebuild/
*.iso
*.img

# Generated onto airootfs by scripts/build-iso.sh — source of truth is
# branding/, desktop/, sessions/, install/, scripts/coda-install.
archiso/airootfs/etc/pacman.d/gnupg/
archiso/airootfs/usr/lib/os-release
archiso/airootfs/etc/issue
archiso/airootfs/etc/issue.net

# local installer secrets — never commit
install/user_credentials.json
install/*credentials*.json

# editor / OS
.DS_Store
*~
*.swp

# python leftovers if someone runs archinstall profile fragments
__pycache__/
*.pyc

# Local ISO copies (do not commit)
/artifacts/

# AGS/Astal source cache and DESTDIR leftovers from vendor-ags.sh
/.cache/
archiso/airootfs/usr/local/bin/ags
archiso/airootfs/usr/local/bin/astal
archiso/airootfs/usr/local/lib/
archiso/airootfs/usr/local/include/
archiso/airootfs/usr/local/share/ags/
archiso/airootfs/usr/local/share/gir-1.0/
archiso/airootfs/usr/local/share/glib-2.0/
archiso/airootfs/etc/ld.so.conf.d/codalinux-usr-local.conf
