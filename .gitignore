# archiso build trees
/work/
/out/
*.iso
*.img

# Generated onto airootfs by scripts/build-iso.sh — source of truth is
# branding/, desktop/, sessions/, install/, scripts/coda-install.
archiso/airootfs/usr/lib/os-release
archiso/airootfs/etc/issue
archiso/airootfs/etc/issue.net

# local installer secrets — never commit
install/user_credentials.json
install/*credentials*.json

# editor / OS
.DS_Store
*~
*.swp

# python leftovers if someone runs archinstall profile fragments
__pycache__/
*.pyc

# Local ISO copies (do not commit)
/artifacts/
